      {
        "name": "The Mark of Chaos Undivided",
        "id": "0b52-6f97-ed7d-d8a6",
        "hidden": false,
        "import": true,
        "type": "upgrade",
        "rules": [
          {
            "name": "The Mark of Chaos Undivided",
            "id": "d2f0-26cb-212c-2e62",
            "description": "• A unit with this Mark gains the Undivided Keyword and may only be joined by units with the Undivided, Khorne, Tzeentch, Nurgle or Slaanesh keywords.\n• A unit with this Mark gains the Fear (1) special rule. If the unit already has the Fear (x) special rule, increase the value of X by 1.\n• In addition, if the unit would fail a Panic test, instead of Falling Back, the unit takes D3 wounds with no saves or mitigation rolls allowed.\n• A unit with this wargear gains access to the Lore of Slaanesh, Nurgle and Tzeentch Psychic Powers if they have the Psyker (x) special rule.",
            "hidden": false
          }
        ]
      },
      {
        "name": "The Mark of Khorne",
        "id": "d7c9-bd72-2650-52d3",
        "hidden": false,
        "import": true,
        "type": "upgrade",
        "rules": [
          {
            "name": "The Mark of Khorne",
            "id": "c49c-5204-67c0-9521",
            "description": "• A unit with this Mark gains the Khorne Keyword and may only join or be joined by units with the Khorne or Undivided Keywords.\n• A unit with this mark gains the Furious Charge special rule. If the unit already has the Furious Charge special rule it gains +1 to its Attack (A) characteristic.\n• A unit with the Psyker (x) special rule may not purchase this wargear.",
            "hidden": false
          }
        ]
      },
      {
        "name": "The Mark of Nurgle",
        "id": "a70f-07f4-5c21-cc20",
        "hidden": false,
        "import": true,
        "type": "upgrade",
        "rules": [
          {
            "name": "The Mark of Nurgle",
            "id": "d707-b941-3716-44dc",
            "description": "• A unit with this Mark gains the Nurgle Keyword and may only join or be joined by units with the Nurgle or Undivided Keywords.\n• A unit with this mark gains the Feel no Pain (5+) special rule. If the unit does not have a Wounds (W) characteristic, it instead always gains the Benefits of Heavy Cover.\n• A unit with this wargear gains access to the Lore of Nurgle Psychic Powers if they have the Psyker (x) special rule.",
            "hidden": false
          }
        ]
      },
      {
        "name": "The Mark of Slaanesh",
        "id": "7e6c-73ce-f18e-2f52",
        "hidden": false,
        "import": true,
        "type": "upgrade",
        "rules": [
          {
            "name": "The Mark of Slaanesh",
            "id": "df64-7d6f-f4db-4e18",
            "description": "• A unit with this Mark gains the Slaanesh Keyword and may only join or be joined by units with the Slaanesh or Undivided Keywords.\n• A unit with this mark gains +1 to their Initiative (I) characteristic.\n• A unit with this Mark gains the Sudden Strike special rule.\n• A unit with this wargear gains access to the Lore of Slaanesh Psychic Powers if they have the Psyker (x) special rule.",
            "hidden": false
          }
        ]
      },
      {
        "name": "The Mark of Tzeentch",
        "id": "8cbd-930e-704b-b337",
        "hidden": false,
        "import": true,
        "type": "upgrade",
        "rules": [
          {
            "name": "The Mark of Tzeentch",
            "id": "d7f6-724a-40ba-fae1",
            "description": "• A unit with this Mark gains the Tzeentch Keyword and may only join or be joined by units with the Tzeentch or Undivided Keywords.\n• A unit with this mark gains +1 to their Invulnerable saves (to a max of 3+). If they do not have an Invulnerable save, they gain a 6+ Invulnerable save.\n• In addition, A unit with this wargear and the Psyker (x) special rule may re-roll 1 dice when making a Psychic Test.\n• A unit with this wargear gains access to the Tzeentch Psychic Powers if they have the Psyker (x) special rule.",
            "hidden": false
          }
        ]
      },
