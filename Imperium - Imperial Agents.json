    "type": "catalogue",
    "publications": [{"name": "The Long War - Codex Imperial Agents", "id": "19c4-6ab7-10c5-8fbe", "hidden": false, "publisher": "5.0"}],
    "sharedRules": [
      {
        "name": "Ion Shield",
        "id": "5e68-787f-9a4a-0137",
        "description": "A model with this special rule has a 4+ Invulnerable save against all Shooting Attacks resolved against its Front Armour Value (FA). In addition, you gain the Rotate Ion Shields Reaction (see below).\n\n\nRotate Ion Shields (Reaction): Instead of Setting to Overwatch, this unit may set to Rotate Ion Shields in its Shooting Phase. If you do so, the unit may still shoot in the Shooting Phase, but all attacks made by the unit are resolved as Snap Shots. At the end of your Opponent’s Charge Phase, you may select one of your units Armour Facings (FA/SA/RA). The units 4+ Invulnerable save from the Ion Shields special rule now applies to Shooting Attacks resolved against the chosen Armour Facing.",
        "hidden": false
      },
      {
        "name": "Special Issue Ammunition",
        "id": "20e0-5740-eacd-3397",
        "description": "A unit with this special rule when firing with an equipped Boltgun, Storm Bolter or Heavy Boltgun, Hurricane Bolter may apply one of the following special ammunition types. All models in the unit must use that same Ammo type during a Shooting Phase.\n• Kraken Rounds: The weapons gain the Rending (6+) special rule.\n• Dragonfire Rounds: The weapons gain the Ignores Cover special rule.\n• Hellfire Rounds: The weapons gain the Poison (4+) special rule this phase.",
        "hidden": false
      },
      {
        "name": "The Aegis",
        "id": "d50b-c69f-49fc-df8d",
        "description": "A unit with this special rule gains the Deny the Witch and Indomitable Spirit (4+) special rules. In addition, the unit’s range for Deny the Witch is 24” instead of 18”.",
        "hidden": false
      },
      {
        "name": "Warding Aura",
        "id": "00c8-e28a-1488-93fa",
        "description": "A model equipped with a weapon that has this special rule and its attached unit improve their Invulnerable save by 1 to a max of 3+ (i.e 5+ becomes 4+, no invul becomes 6+) if the equipped models unit Remained Stationary in their previous Movement Phase.",
        "hidden": false
      }
    ],
    "sharedSelectionEntries": [
      {
        "name": "Boarding Shields",
        "id": "a57d-606c-5014-f00a",
        "collective": true,
        "hidden": false,
        "import": true,
        "page": "7",
        "publicationId": "19c4-6ab7-10c5-8fbe",
        "type": "upgrade",
        "constraints": [{"id": "a16e-ce34-1b38-118a", "field": "selections", "includeChildSelections": false, "scope": "parent", "shared": true, "type": "max", "value": 1}],
        "rules": [
          {
            "name": "Boarding Shields",
            "id": "bf75-95a5-b64e-bd71",
            "description": "A model equipped with this wargear gains a 5+ Invulnerable save. If at least 3 models in a unit are equipped with Boarding Shields, all charges against the equipped unit are treated as Disordered Charges.",
            "hidden": false
          }
        ]
      },
