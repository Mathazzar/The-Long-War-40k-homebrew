{
  "catalogue": {
    "name": "Imperium - Space Marines - Salamanders",
    "id": "b156-90bb-8d29-1b80",
    "battleScribeVersion": "2.03",
    "gameSystemId": "sys-a003-176c-de1f-4eba",
    "gameSystemRevision": 20,
    "library": true,
    "revision": 1,
    "type": "catalogue",
    "catalogueLinks": [{"name": "Imperium - shared rules", "id": "3570-5733-a5f7-4863", "targetId": "cb87-e388-9772-a046", "type": "catalogue"}],
    "publications": [{"name": "The Long War – Codex Supplement Salamanders", "id": "e82a-a342-9a4a-1bdc", "hidden": false, "publisher": "5.0"}],
    "sharedRules": [
      {
        "name": "Sanctified by Fire",
        "id": "cc7b-9503-ed95-cf8b",
        "description": "Instead of setting to Overwatch, a unit may set to Sanctify an Objective. A unit that sets to Sanctify may select a single Objective Marker within 6” of it. That Objective Marker is removed from the battlefield and can no longer be used to score Victory Points.",
        "hidden": false,
        "page": "4",
        "publicationId": "e82a-a342-9a4a-1bdc"
      },
      {
        "name": "Strength of Nocturne",
        "id": "65c0-d02e-fcb9-66a4",
        "description": "All Salamanders units gain the following benefits:\n• All ‘Flamer’, ‘Acid’, ‘Plasma’, ‘Bio-Plasma’, ‘Melta’, ‘Fusion’, ‘Phosphor’, and ‘Volkite’ weapons have -1 to all Wound rolls against Salamanders units.\n• Salamanders units with the Character special rule gain the Master-Crafted special rule on all weapons they are equipped with.",
        "hidden": false,
        "page": "3",
        "publicationId": "e82a-a342-9a4a-1bdc"
      },
      {
        "name": "Cautious Pace",
        "id": "7975-717a-919f-bcf4",
        "description": "• All Salamanders units have -1 to their Initiative (I) characteristic (This is included in Salamanders specific units).\n• Salamanders Javelin Assault Speeders, Storm Speeders and Land Speeders gain Limited: 1 Per Detachment.\n• Salamanders Tactical Terminators and Assault Terminators gain Limited: 1 Per Detachment.",
        "hidden": false,
        "page": "3",
        "publicationId": "e82a-a342-9a4a-1bdc"
      },
      {
        "name": "Adherent of Prophecy",
        "id": "7435-bc71-e750-e7c1",
        "description": "A unit with this special rule always counts as holding an objective regardless of the number of enemy models contesting the objective.",
        "hidden": false,
        "page": "4",
        "publicationId": "e82a-a342-9a4a-1bdc"
      },
      {
        "name": "Master-Crafted Weapon",
        "id": "eefa-a8f5-e651-c0a2",
        "description": "A model equipped with this wargear selects 1 weapon they are equipped with. It gains the Master-Crafted special rule. If a unit with this special rule has 2 more models and every unit has purchased this wargear, they can re-roll hit rolls of 1 instead with all Weapons they are equipped with.",
        "hidden": false
      },
      {
        "name": "Master-Crafted Promethean Armour",
        "id": "f1c6-f438-25c8-338c",
        "description": "A model equipped with this wargear may re-roll 1 Armour Save roll per Phase. If a unit with this special rule has 2 more models and every unit has purchased this wargear, they can re-roll Armour Save rolls of 1 instead.",
        "hidden": false
      },
      {
        "name": "Dragon Rage",
        "id": "d024-5100-1910-ea8e",
        "description": "Wounds inflicted by a weapon with this special rule cannot be ignored with the Feel no Pain (x) special rule.",
        "hidden": false
      }
    ],
