    "sharedRules": [
      {
        "name": "She Who Thirsts",
        "id": "3189-d509-57a0-892d",
        "description": "Eldar units with this special rule have the Hatred (Slaanesh) special rule.",
        "hidden": false,
        "page": "3",
        "publicationId": "00c7-1ca1-5217-deec"
      },
      {
        "name": "Jetbike",
        "id": "8e1c-e4ef-0bdb-145a",
        "description": "A model that is equipped with Jetbike becomes the Jetbike type. The Jetbike increases the models Toughness (T) by 1. The Jetbike is equipped with Linked Shuriken Catapults.",
        "hidden": false
      },
      {
        "name": "Monofilament",
        "id": "fe7f-f424-2856-ab7f",
        "description": "When rolling to wound or penetrate against a target with this weapon, instead of using the targets Toughness (T) characteristic roll to wound by comparing the targets Initiative (I) characteristic to the weapons Strength (S) characteristic on the wound chart. Monofilament weapons are resolved against the AV of Vehicles, Fortifications, Titans, Knights and Aircraft type units as normal. For Instant Death, the weapon is Instant Death if its Strength (S) characteristic is double the targets Initiative (I) characteristic.",
        "hidden": false
      },
      {"name": "Eldar Reflexes", "id": "bf1b-9d95-bc18-891b", "comment": "todo: No profile provided in reference", "hidden": false}
    ],
    "sharedSelectionEntries": [
      {
        "name": "Webway Gate",
        "id": "0dfc-2c96-f2d4-0434",
        "hidden": false,
        "import": true,
        "page": "64",
