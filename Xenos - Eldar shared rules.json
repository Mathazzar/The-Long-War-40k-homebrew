        "rules": [
          {
            "name": "Gate from beyond",
            "id": "5ed7-1ac7-2577-950a",
            "description": "When Eldar units arrive via Outflank, they may be placed wholly within 12” of a Webway gate piece so long as they are more than 3” from any enemy models",
            "hidden": false
          },
          {
            "name": "Hidden Webways",
            "id": "b72a-960b-d72d-cd9b",
            "description": "The Webway Gate model is made of 2 pieces. During deployment, you may place both pieces together in contact in your deployment zone or you can place 1 in your deployment zone and the other anywhere on the bord, more than 9” away from any enemy models.",
            "hidden": false
          },
          {
            "name": "Linked Gates",
            "id": "5a94-d445-b065-d08a",
            "description": "If, during deployment you opted to deploy your gate as 2 separate gates, they are considered Linked. During the Movement Phase, friendly Eldar models may embark on this model. The Eldar models may disembark per normal from any Webway gate piece on the board. There is no limit to the number of type of models that may embark on a Webway Gate.",
            "hidden": false
          }
        ],
