    "sharedRules": [
      {
        "name": "Strength from Death",
        "id": "a5d2-f6a4-2795-cf0a",
        "description": "In a turn in which any unit dies (friend or foe), a unit with this special rule gains +1 to their Strength (S) and Toughness (T) characteristics until the start of the next turn.",
        "hidden": false
      },
      {
        "name": "Sorrow",
        "id": "7cc1-e51a-d650-51c2",
        "description": "If a unit suffers an un-saved wound inflicted by this weapon, it must make a Panic Test regardless of whether the target units side won the Combat.",
        "hidden": false
      },
      {
        "name": "Silence",
        "id": "f210-f5e4-2497-d512",
        "description": "A unit which suffers 1 or more hits from a weapon with this special rule halves their Leadership (LD) characteristic until the end of the Phase. In addition, units hit by this weapon do not gain the benefit of the Stubborn special rule.",
        "hidden": false
      }
    ],
